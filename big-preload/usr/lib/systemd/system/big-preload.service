[Unit]
Description=Preload essential files into page cache (vmtouch)
# Runs while the login screen waits for a password. DefaultDependencies=no keeps
# any target that wants this unit from waiting for it.
DefaultDependencies=no
After=display-manager.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=exec
ExecStart=-/usr/bin/big-preload
Nice=19
IOSchedulingClass=idle
IOSchedulingPriority=7
CPUSchedulingPolicy=idle

[Install]
WantedBy=graphical.target
